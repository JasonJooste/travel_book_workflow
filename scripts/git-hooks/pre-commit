#!/bin/sh
# Doc checks (CONTRIBUTING.md, "Automatic checks"). A merge that stopped on conflicts is committed
# through here, not pre-merge-commit, so it gets the merge check.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    exec python3 scripts/git-hooks/check_docs.py merge
fi
exec python3 scripts/git-hooks/check_docs.py commit
